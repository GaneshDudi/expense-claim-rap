@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName:       'Expense Claim',
    typeNamePlural: 'Expense Claims',
    title:          { type: #STANDARD, value: 'ClaimID' },
    description:    { value: 'Description' }
  }
}
annotate entity ZGS_C_ExpClaim with
{
  @UI.facet: [
    { id:       'ClaimDetails',
      purpose:  #STANDARD,
      type:     #IDENTIFICATION_REFERENCE,
      label:    'Claim Details',
      position: 10 },
    { id:            'ExpenseItems',
      purpose:       #STANDARD,
      type:          #LINEITEM_REFERENCE,
      label:         'Expense Items',
      position:      20,
      targetElement: '_Item' }
  ]
  @UI.hidden: true
  ClaimUUID;

  @UI.lineItem: [
    { position: 10, label: 'Claim' },
    { type: #FOR_ACTION, dataAction: 'submit', label: 'Submit' },
    { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
    { type: #FOR_ACTION, dataAction: 'reject',  label: 'Reject' },
    { type: #FOR_ACTION, dataAction: 'copyClaim', label: 'Copy' },
     { type: #FOR_ACTION, dataAction: 'approveAllSubmitted', label: 'Approve All Submitted' }
  ]
  @UI.identification: [
    { position: 10, label: 'Claim' },
    { type: #FOR_ACTION, dataAction: 'submit', label: 'Submit' },
    { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
    { type: #FOR_ACTION, dataAction: 'reject',  label: 'Reject' },
     { type: #FOR_ACTION, dataAction: 'copyClaim', label: 'Copy' },
     { type: #FOR_ACTION, dataAction: 'approveAllSubmitted', label: 'Approve All Submitted' }
  ]
  @UI.selectionField: [{ position: 10 }]
  ClaimID;

  @UI.lineItem:       [{ position: 20, label: 'Employee' }]
  @UI.identification: [{ position: 20, label: 'Employee' }]
  @UI.selectionField: [{ position: 20 }]
  Employee;

  @UI.lineItem:       [{ position: 30, label: 'Description' }]
  @UI.identification: [{ position: 30, label: 'Description' }]
  Description;

  @UI.lineItem:       [{ position: 40, label: 'Status' }]
  @UI.identification: [{ position: 40, label: 'Status' }]
  @UI.selectionField: [{ position: 30 }]
  Status;
    @UI.identification: [{ position: 45, label: 'Rejection Reason' }]
  RejectionReason;

  @UI.lineItem:       [{ position: 50, label: 'Total Amount' }]
  @UI.identification: [{ position: 50, label: 'Total Amount' }]
  TotalAmount;

  @UI.identification: [{ position: 55, label: 'Currency' }]
  CurrencyCode;

  @UI.identification: [{ position: 60, label: 'Created By' }]
  CreatedBy;

  @UI.identification: [{ position: 70, label: 'Created At' }]
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}